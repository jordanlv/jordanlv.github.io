---
import Icon from './Icon.astro';
import publications from '../data/publications.json';

interface Publication {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  type: string;
  lang?: string;
  summary: string;
  image?: string;
  url?: string; // paper page (PDF, arXiv, DOI…), opened from the title
}

const SELF = 'J. Levy';

const pubs = (publications as Publication[]).toSorted((a, b) => b.year - a.year);
const years = [...new Set(pubs.map((pub) => pub.year))];
---

<section class="section container" id="publications">
  <div class="section-head">
    <h2 class="section-title">
      Publications <span class="tag count" data-pub-count>{pubs.length}</span>
    </h2>

    <label class="select">
      <span class="visually-hidden">Filter by date</span>
      <select data-pub-filter>
        <option value="">All dates</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
      <Icon name="caret" size={14} />
    </label>
  </div>

  <ol class="pubs">
    {
      pubs.map((pub) => {
        const words = pub.title.split(' ');
        return (
          <li class="pub" data-year={pub.year}>
            <div class="pub-thumb">
              {pub.image ? (
                <img src={pub.image} alt="" loading="lazy" />
              ) : (
                <span>{pub.venue || pub.type}</span>
              )}
            </div>

            <div class="pub-body">
              <p class="pub-meta">
                <span>{pub.year}</span>
                <span aria-hidden="true">–</span>
                <span>{pub.venue || pub.type}</span>
                <span class="tag">{pub.type}</span>
                {pub.lang === 'fr' && <span class="tag">FR</span>}
              </p>

              <h3 class="pub-title">
                {pub.url ? (
                  <a href={pub.url} target="_blank" rel="noopener">
                    {words.slice(0, -1).join(' ')}{' '}
                    {/* Keep the arrow on the same line as the last word */}
                    <span class="nowrap">
                      {words.at(-1)}
                      <Icon name="arrow" size={14} />
                    </span>
                  </a>
                ) : (
                  pub.title
                )}
              </h3>

              <p class="pub-authors">
                {pub.authors.map((author, i) => (
                  <>
                    {author === SELF ? <strong>{author}</strong> : author}
                    {i < pub.authors.length - 1 && ', '}
                  </>
                ))}
              </p>

              <p class="pub-summary">{pub.summary}</p>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<script>
  const filter = document.querySelector<HTMLSelectElement>('[data-pub-filter]');
  const count = document.querySelector<HTMLElement>('[data-pub-count]');
  const items = document.querySelectorAll<HTMLElement>('.pub');

  filter?.addEventListener('change', () => {
    let visible = 0;
    items.forEach((item) => {
      const show = !filter.value || item.dataset.year === filter.value;
      item.hidden = !show;
      if (show) visible++;
    });
    if (count) count.textContent = String(visible);
  });
</script>
