---
import Icon from './Icon.astro';
import Dropdown from './Dropdown.astro';
import PaperMeta from './PaperMeta.astro';
import PaperAuthors from './PaperAuthors.astro';
import { languageNames, languages, ui, type Lang } from '../i18n';
import { getPapers, paperPath } from '../lib/papers';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const papers = await getPapers();

// Filter options only list values that actually occur
const years = [...new Set(papers.map((paper) => paper.data.year))];
const formats = (['article', 'poster'] as const).filter((format) => papers.some((paper) => paper.data.format === format));
const paperLangs = languages.filter((l) => papers.some((paper) => paper.data.lang === l));
---

<section class="section container" id="publications">
  <div class="section-head">
    <h2 class="section-title">
      {t.publications} <span class="tag count" data-pub-count>{papers.length}</span>
    </h2>

    <div class="filters">
      <Dropdown
        name="year"
        label={t.filterByDate}
        options={[{ value: '', label: t.allDates }, ...years.map((year) => ({ value: String(year), label: String(year) }))]}
      />
      <Dropdown
        name="format"
        label={t.filterByFormat}
        options={[{ value: '', label: t.allFormats }, ...formats.map((format) => ({ value: format, label: t.formats[format] }))]}
        selected="article"
      />
      <Dropdown
        name="lang"
        label={t.filterByLanguage}
        options={[{ value: '', label: t.allLanguages }, ...paperLangs.map((l) => ({ value: l, label: languageNames[l] }))]}
        selected="en"
      />
    </div>
  </div>

  <ol class="pubs">
    {
      papers.map((paper) => {
        const { title, authors, venue, year, type, image, format } = paper.data;
        const href = paperPath(lang, paper.id);
        return (
          <li class="pub" data-year={year} data-format={format} data-lang={paper.data.lang}>
            {/* Decorative duplicate of the title link: hidden from assistive tech and tab order */}
            <a class="pub-thumb" href={href} tabindex="-1" aria-hidden="true">
              {image ? <img src={image} alt="" loading="lazy" /> : <span class="thumb-label">{venue || t.types[type]}</span>}
            </a>

            <div class="pub-body">
              <PaperMeta paper={paper} lang={lang} />
              <h3 class="pub-title">
                <a href={href}>{title}</a>
              </h3>
              <PaperAuthors authors={authors} compact />
              <p class="pub-summary">{paper.data.summary[lang]}</p>
            </div>
          </li>
        );
      })
    }
  </ol>

  <p class="pubs-empty" data-pub-empty hidden>{t.noResults}</p>

  <div class="pubs-more">
    <button type="button" class="pill-button" data-pub-more hidden>
      {t.showMore}
      <Icon name="caret" size={14} />
    </button>
  </div>
</section>

<script>
  const PAGE_SIZE = 4;

  const count = document.querySelector<HTMLElement>('[data-pub-count]');
  const more = document.querySelector<HTMLButtonElement>('[data-pub-more]');
  const empty = document.querySelector<HTMLElement>('[data-pub-empty]');
  const items = [...document.querySelectorAll<HTMLElement>('.pub')];

  // Shared list state: every filter must match (an empty value means "all"),
  // and only the first PAGE_SIZE matches are shown until "Show more" is clicked
  // Start from each dropdown's initially selected option
  const filters: Record<string, string> = {};
  document.querySelectorAll<HTMLElement>('#publications [data-dropdown]').forEach((dropdown) => {
    const selected = dropdown.querySelector<HTMLElement>('[role=option][aria-selected=true]');
    filters[dropdown.dataset.dropdown!] = selected?.dataset.value ?? '';
  });
  let expanded = false;

  const render = () => {
    const matching = items.filter((item) =>
      Object.entries(filters).every(([name, value]) => !value || item.dataset[name] === value),
    );
    items.forEach((item) => {
      const index = matching.indexOf(item);
      item.hidden = index === -1 || (!expanded && index >= PAGE_SIZE);
    });
    if (count) count.textContent = String(matching.length);
    if (empty) empty.hidden = matching.length > 0;
    if (more) more.hidden = expanded || matching.length <= PAGE_SIZE;
  };

  document.querySelector('#publications')?.addEventListener('dropdown-change', (event) => {
    const { name, value } = (event as CustomEvent<{ name: string; value: string }>).detail;
    if (!(name in filters)) return;
    filters[name] = value;
    expanded = false;
    render();
  });

  more?.addEventListener('click', () => {
    expanded = true;
    render();
  });

  render();
</script>
