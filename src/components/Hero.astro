---
import Icon from './Icon.astro';
import profile from '../data/profile.json';

type IconName = 'github' | 'scholar' | 'linkedin' | 'mail';

// First name in black, last name in grey
const [firstName, ...rest] = profile.name.split(' ');
const lastName = rest.join(' ');
---

<section class="hero container" id="top">
  <div class="avatar">
    {profile.photo ? <img src={profile.photo} alt={profile.name} width="88" height="88" /> : <span>{profile.initials}</span>}
  </div>

  <h1>
    {firstName} <span class="muted">{lastName}</span>
  </h1>
  <p class="role">{profile.role}</p>
  <p class="bio">{profile.bio}</p>

  <ul class="links">
    {
      profile.links.map((link) => (
        <li>
          <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <Icon name={link.icon as IconName} size={16} />
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
