---
import Icon from './Icon.astro';
import profile from '../data/profile.json';

type IconName = 'github' | 'scholar' | 'linkedin' | 'mail';
---

<section class="hero container" id="top">
  <div class="identity">
    <div class="avatar">
      {profile.photo ? <img src={profile.photo} alt={profile.name} width="72" height="72" /> : <span>{profile.initials}</span>}
    </div>
    <div>
      <p class="identity-name">{profile.name}</p>
      <p class="identity-role">{profile.role}</p>
    </div>
  </div>

  <h1>
    {profile.tagline[0]} <span class="muted">{profile.tagline[1]}</span>
  </h1>
  <p class="bio">{profile.bio}</p>

  <ul class="links">
    {
      profile.links.map((link) => (
        <li>
          <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <Icon name={link.icon as IconName} size={16} />
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
