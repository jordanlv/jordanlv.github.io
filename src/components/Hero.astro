---
import Icon from './Icon.astro';
import profile from '../data/profile.json';

type IconName = 'github' | 'scholar' | 'linkedin' | 'mail';

// First name in black, last name in grey
const [firstName, ...rest] = profile.name.split(' ');
const lastName = rest.join(' ');
---

<section class="hero container" id="top">
  <div class="avatar">
    {profile.photo ? <img src={profile.photo} alt={profile.name} width="92" height="92" /> : <span>{profile.initials}</span>}
  </div>

  <h1>
    <span class="hero-name">{firstName} <span class="muted">{lastName}</span></span>
  </h1>
  <p class="role">{profile.role}</p>
  <p class="bio">{profile.bio}</p>

  <ul class="links">
    {
      profile.links.map((link) => (
        <li>
          <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel="noopener" data-icon={link.icon}>
            <Icon name={link.icon as IconName} size={16} />
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  // Scroll-linked morph: the hero name shrinks and slides into the header logo spot,
  // then hands over to the real header logo. Scrolling back up reverses it.
  const name = document.querySelector<HTMLElement>('.hero-name');
  const logo = document.querySelector<HTMLElement>('.logo');

  if (name && logo) {
    const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
    let geometry = { dx: 0, scale: 1, distance: 1 };

    const measure = () => {
      name.style.transform = '';
      const n = name.getBoundingClientRect();
      const l = logo.getBoundingClientRect(); // sticky header: constant viewport position
      const scale = parseFloat(getComputedStyle(logo).fontSize) / parseFloat(getComputedStyle(name).fontSize);
      // Top the scaled name must reach so it sits vertically centred on the logo
      const targetTop = l.top + (l.height - n.height * scale) / 2;
      geometry = {
        dx: l.left - n.left,
        scale,
        // Scroll offset at which the name, moving up with the page, reaches targetTop
        distance: Math.max(1, n.top + window.scrollY - targetTop),
      };
      update();
    };

    const update = () => {
      const progress = Math.min(1, Math.max(0, window.scrollY / geometry.distance));
      const t = easeInOut(progress);
      const scale = 1 + (geometry.scale - 1) * t;
      // Vertical motion comes from the page scroll itself; only x and scale are animated
      name.style.transform = `translate(${geometry.dx * t}px, 0) scale(${scale})`;
      const docked = progress >= 1;
      name.style.visibility = docked ? 'hidden' : '';
      logo.classList.toggle('is-visible', docked);
    };

    // Scroll events already fire at most once per frame, so update directly:
    // going through requestAnimationFrame made the name lag when rAF is throttled
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', measure);
    document.fonts.ready.then(measure);
    measure();
  }
</script>
