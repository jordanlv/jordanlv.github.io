---
import Icon from './Icon.astro';
import profile from '../data/profile.json';

type IconName = 'github' | 'scholar' | 'linkedin' | 'mail';
---

<section class="hero container" id="top">
  <div class="avatar">
    {profile.photo ? <img src={profile.photo} alt={profile.name} /> : <span>{profile.initials}</span>}
  </div>

  <p class="eyebrow">{profile.role}</p>
  <h1>
    {profile.name}
    <span class="muted">— explainable anomaly detection for autonomous robots.</span>
  </h1>
  <p class="bio">{profile.bio}</p>

  <ul class="links">
    {
      profile.links.map((link) => (
        <li>
          <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <Icon name={link.icon as IconName} size={16} />
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
