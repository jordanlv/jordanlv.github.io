---
// Phosphor icons (regular weight) — https://phosphoricons.com
import github from '@phosphor-icons/core/assets/regular/github-logo.svg?raw';
import scholar from '@phosphor-icons/core/assets/regular/graduation-cap.svg?raw';
import linkedin from '@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw';
import mail from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';
import sun from '@phosphor-icons/core/assets/regular/sun.svg?raw';
import moon from '@phosphor-icons/core/assets/regular/moon.svg?raw';
import arrow from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import caret from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';

const icons = { github, scholar, linkedin, mail, sun, moon, arrow, caret };

interface Props {
  name: keyof typeof icons;
  size?: number;
}

const { name, size = 18 } = Astro.props;

const svg = icons[name].replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" `);
---

<Fragment set:html={svg} />
