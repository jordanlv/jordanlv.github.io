---
import Icon from './Icon.astro';
import profile from '../data/profile.json';
import { homePath, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Home page: links are in-page anchors and the logo waits for the hero name to dock */
  isHome?: boolean;
}

const { lang, isHome = false } = Astro.props;
const t = ui[lang];
const home = isHome ? '' : homePath[lang];

const [firstName, ...rest] = profile.name.split(' ');
const lastName = rest.join(' ');
---

<header class="header">
  <div class="container header-inner">
    <!-- On the home page it stays hidden at the top: the hero name morphs into this spot on scroll (see Hero.astro) -->
    <a href={isHome ? '#top' : home} class:list={['logo', { 'is-visible': !isHome }]}>{firstName} <span class="muted">{lastName}</span></a>
    <nav class="nav">
      <div class="nav-links">
        <a href={`${home}#experience`}>{t.experience}</a>
        <a href={`${home}#publications`}>{t.publications}</a>
        <a href={`${home}#projects`}>{t.projectsNav}</a>
      </div>
      <div class="nav-menu-wrap" data-nav-menu>
        <button class="icon-button nav-menu-toggle" type="button" aria-label={t.menu} aria-expanded="false">
          <span class="icon-menu-open"><Icon name="menu" size={16} /></span>
          <span class="icon-menu-close"><Icon name="close" size={16} /></span>
        </button>
        <div class="dropdown-menu nav-dropdown" hidden>
          <a href={`${home}#experience`}>{t.experience}</a>
          <a href={`${home}#publications`}>{t.publications}</a>
          <a href={`${home}#projects`}>{t.projectsNav}</a>
        </div>
      </div>
      <a href="/cv.pdf" target="_blank" rel="noopener" class="nav-cv" aria-label={t.resume} title={t.resume}>
        <Icon name="file" size={16} />
        <span class="nav-cv-label">{t.resume}</span>
      </a>
      <button class="icon-button theme-toggle" type="button" aria-label={t.toggleTheme}>
        <span class="icon-sun"><Icon name="sun" size={16} /></span>
        <span class="icon-moon"><Icon name="moon" size={16} /></span>
      </button>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const menuWrap = document.querySelector<HTMLElement>('[data-nav-menu]');
  const menuToggle = menuWrap?.querySelector<HTMLButtonElement>('.nav-menu-toggle');
  const menuDropdown = menuWrap?.querySelector<HTMLElement>('.nav-dropdown');

  const closeMenu = () => {
    if (!menuToggle || !menuDropdown) return;
    menuToggle.setAttribute('aria-expanded', 'false');
    menuDropdown.hidden = true;
  };

  const updateHeader = () => {
    const scrolled = window.scrollY > 0;
    header?.classList.toggle('is-scrolled', scrolled);
    if (!scrolled) closeMenu();
  };
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  menuToggle?.addEventListener('click', () => {
    if (!menuDropdown) return;
    const open = menuDropdown.hidden;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuDropdown.hidden = !open;
  });

  menuDropdown?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('click', (event) => {
    if (menuWrap && !menuWrap.contains(event.target as Node)) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
